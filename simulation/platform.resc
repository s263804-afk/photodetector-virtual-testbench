include @simulation/LoopbackTerminal.cs
using sysbus
mach create "photo"
machine LoadPlatformDescription @simulation/platform.repl
emulation CreateLoopbackTerminal 12345 "uart"
connector Connect sysbus.usart2 uart
usart2 CreateFileBackend @.local/uart-production.log true
macro reset
"""
    sysbus LoadELF @build/arm/photo-firmware.elf
    cpu VectorTableOffset 0x08000000
"""
runMacro $reset
start
